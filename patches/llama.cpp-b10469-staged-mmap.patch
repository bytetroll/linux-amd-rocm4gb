+def test_router_late_request_for_reserved_victim_waits_and_reloads():
+    """a request arriving after its model is reserved must queue, not hit the dying child"""
+    global server
+    server.models_max = 1
+    server.start()
+
+    _load_model_and_wait(MODEL_A, timeout=120)
+
+    # LLAMA_SERVER_DEBUG_FAKE_TIMING holds the handoff after MODEL_B reserves
+    # idle MODEL_A. The late request therefore deterministically reaches the
+    # router while MODEL_A is still alive but no longer accepts new work.
+    first = _Bg(lambda: _tokenize(MODEL_B)).start()
+    time.sleep(0.5)
+    late = _Bg(lambda: _tokenize(MODEL_A)).start()
+
+    first.join(120)
+    late.join(180)
+
+    first.assert_ok("request owning the first replacement slot")
+    late.assert_ok("late request against the reserved victim")
+    assert first.done_at < late.done_at, "late victim request bypassed the FIFO handoff"
+    _wait_for_model_status(MODEL_A, {"loaded"}, timeout=120)
+    assert _get_model_status(MODEL_B) == "unloaded"
+
