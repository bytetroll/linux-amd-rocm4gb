#!/usr/bin/env bash

set -euo pipefail

project_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
command_name=${1:-help}
if (($#)); then shift; fi

case "$command_name" in
    doctor)   exec "$project_root/doctor.sh" "$@" ;;
    install)  exec "$project_root/install.sh" "$@" ;;
    verify)   exec "$project_root/verify.sh" "$@" ;;
    rollback) exec "$project_root/rollback.sh" "$@" ;;
    help|-h|--help)
        cat <<'EOF'
Usage: ./rocm4gb COMMAND [options]

Commands:
  doctor    inspect the host without changing it
  install   fetch, verify, patch, build, and install in isolation
  verify    run a guarded large-GGUF qualification
  rollback  switch back to the previously active project-owned build

Run './rocm4gb COMMAND --help' for command-specific options.
EOF
        ;;
    *)
        printf 'linux-amd-rocm4gb: unknown command: %s\n' "$command_name" >&2
        exit 2
        ;;
esac
